# BPS Web API key. Keep this empty in source control.
BPS_API_KEY=

# BHUMI's anti-bot gateway may require an active browser cookie.
# Keep both values in local .env only; never commit or share cookie contents.
BHUMI_COOKIE=
BHUMI_USER_AGENT=
BHUMI_SEC_CH_UA=
BHUMI_SEC_CH_UA_MOBILE=
BHUMI_SEC_CH_UA_PLATFORM=
BHUMI_REQUEST_TIMEOUT_MS=15000
BHUMI_RIGHTS_GRID_SIZE=5

# Existing application settings
INSTAGRAM_LOCATIONS_ENABLED=false
INSTAGRAM_LOCATIONS_TIMEOUT_MS=30000
PORT=3000
# Dukcapil portal layer type. The current public map uses MapServer; the
# backend falls back to FeatureServer when configured/available.
DUKCAPIL_KELURAHAN_SERVICE_TYPE=MapServer
DUKCAPIL_DEMOGRAPHY_SERVICE_TYPE=MapServer
TINYFISH_API_KEY=
TINYFISH_RESEARCH_TIMEOUT_MS=900000
