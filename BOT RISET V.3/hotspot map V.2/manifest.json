{
  "manifest_version": 3,
  "name": "HOTMAP SMARTKIDZ",
  "version": "2.0",
  "description": "Smartkidz Hot Map",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://emsifa.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
